# PostgreSQL connection using DATABASE_URL
# Example for Railway or any managed DB
DATABASE_URL=postgres://username:password@hostname:5432/database_name

# Local PostgreSQL host/database settings (comment out DATABASE_URL if using these)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=your_database

# Optional SSL mode for PostgreSQL
# PGSSLMODE=disable

# Application port
PORT=8080

# Required: long random secret used to sign login sessions
AUTH_SECRET=replace_with_a_long_random_secret

# Required in production: comma-separated frontend origins allowed to call the API and Socket.IO
# Example: https://stockpos.example.com,https://stockpos-staging.example.com
FRONTEND_ORIGINS=https://your-frontend.example.com

# Enable encrypted API request/response envelopes for the production frontend.
# Keep false or omit it for local development.
API_PAYLOAD_ENCRYPTION_ENABLED=false

# Enable the read-only AI system assistant. Choose exactly one provider.
# Add these in Railway Backend before enabling the assistant in production.
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_PROVIDER=ollama
AI_ASSISTANT_TIMEOUT_MS=90000

# Ollama on Railway: keep this private URL in the Backend service only.
# Change "ollama" if your Railway service uses a different name.
OLLAMA_BASE_URL=http://${{ollama.RAILWAY_PRIVATE_DOMAIN}}:11434
OLLAMA_ASSISTANT_MODEL=llama3.2:1b

# OpenAI alternative. Leave empty when AI_ASSISTANT_PROVIDER=ollama.
OPENAI_API_KEY=your_openai_api_key
OPENAI_ASSISTANT_MODEL=gpt-5-mini

# Optional: warn when a menu can be made no more than this many times (default 5)
MENU_LOW_STOCK_THRESHOLD=5
